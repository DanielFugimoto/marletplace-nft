# Ativa a camada de mocks (MSW REST + Socket.IO). "true" em dev, demo e testes.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (interceptadas pelo MSW quando os mocks estão ativos).
VITE_API_URL=/api
# URL do servidor Socket.IO (vazio = mesma origem). Interceptado pelo MSW via @mswjs/socket.io-binding.
VITE_SOCKET_URL=
